    "/v1/voices": {
      "get": {
        "tags": [
          "Głosy"
        ],
        "operationId": "listVoices",
        "summary": "Lista głosów",
        "description": "Głosy z biblioteki Narrivy oraz Twoje własne (zaprojektowane i sklonowane).",
        "parameters": [
          {
            "name": "language",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Tylko głosy obsługujące język, np. `pl`."
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "audiobooks",
                "social_media",
                "media_business",
                "gaming_animation",
                "wellness_relax"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Głosy.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": {
                      "const": "list"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Voice"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Brak lub nieprawidłowy klucz API (`missing_api_key`, `invalid_api_key`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Plan bez dostępu do API (`plan_required`) lub niepotwierdzony e-mail (`email_not_verified`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Limit żądań na minutę (`rate_limit_exceeded`) lub równoległych syntez (`concurrency_limit_exceeded`). Sprawdź nagłówek `Retry-After`.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Po ilu sekundach ponowić."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
