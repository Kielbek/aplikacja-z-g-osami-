# Serwer aplikacji Narrivy (produkcja). Skopiuj do .env i uzupełnij. Nigdy nie commituj .env.

# --- Domena i HTTPS ---
DOMAIN=app.narrivy.pl
ACME_EMAIL=admin@narrivy.pl

# --- Sekrety (wygeneruj: openssl rand -base64 48) ---
POSTGRES_PASSWORD=
JWT_SECRET=

# --- Silnik mowy na serwerze GPU ---
# Hetzner (sieć prywatna):  http://10.0.0.3:8808
# RunPod:                   https://<ID_PODA>-8808.proxy.runpod.net
ENGINE_URL=
# Ten sam klucz co na serwerze GPU (openssl rand -hex 32)
ENGINE_API_KEY=

# --- Nagrania: Cloudflare R2 (bucket w jurysdykcji UE) ---
STORAGE_TYPE=s3
S3_BUCKET=narrivy-audio
S3_REGION=auto
S3_ENDPOINT=https://<ID_KONTA>.eu.r2.cloudflarestorage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- E-mail (potwierdzanie adresów, reset hasła) ---
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=Narrivy <no-reply@narrivy.pl>

# --- Opcjonalnie ---
GOOGLE_CLIENT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
