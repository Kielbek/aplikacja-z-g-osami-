# HTTPS z automatycznym certyfikatem Let's Encrypt (domena musi wskazywać na ten serwer: rekord A/AAAA).
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=(self)"
		-Server
	}

	# Frontend (nginx) przekazuje /api i /v1 do backendu
	reverse_proxy frontend:80
}

# Adres z „www” przekierowuje na właściwą domenę
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
