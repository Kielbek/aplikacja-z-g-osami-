# Serwer GPU z silnikiem Narrivy. Skopiuj do .env i uzupełnij.

# Klucz wspólny z serwerem aplikacji (openssl rand -hex 32, min. 32 znaki)
ENGINE_API_KEY=

# --- Wariant A: HTTPS (docker compose --profile https up -d --build) ---
# Subdomena wskazująca na TEN serwer (rekord A), np. engine.narrivy.pl
ENGINE_DOMAIN=
# Publiczny adres IP serwera aplikacji — tylko on zostanie wpuszczony
APP_SERVER_IP=
ACME_EMAIL=

# --- Wariant B: sieć prywatna Hetznera ---
# Prywatny adres IP tego serwera (vSwitch / Cloud Network), np. 10.0.0.3
# ENGINE_BIND=10.0.0.3
