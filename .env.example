# Skopiuj do .env i uzupełnij. Nigdy nie commituj pliku .env.

# --- Wymagane ---
POSTGRES_PASSWORD=zmien-mnie
JWT_SECRET=wygeneruj-np-openssl-rand-base64-48-min-32-znaki

# Port aplikacji na komputerze (zmień, jeśli 4200 jest zajęty — wtedy zmień też PUBLIC_URL)
FRONTEND_PORT=4200

# Adres, pod którym użytkownicy otwierają aplikację (linki w e-mailach, powroty ze Stripe)
PUBLIC_URL=http://localhost:4200
# true, gdy aplikacja działa przez HTTPS
COOKIE_SECURE=false

# --- Magazyn nagrań ---
# local = wolumen backendu (domyślnie); s3 = AWS S3 / Cloudflare R2 / Backblaze B2 / własne S3
STORAGE_TYPE=local
# Cloudflare R2 (zalecane: brak opłat za pobieranie). Bucket w jurysdykcji UE → adres z „.eu.”:
# STORAGE_TYPE=s3
# S3_BUCKET=narrivy-audio
# S3_REGION=auto
# S3_ENDPOINT=https://<ID_KONTA>.eu.r2.cloudflarestorage.com
# S3_PATH_STYLE=false
# S3_ACCESS_KEY=<Access Key ID z tokenu R2>
# S3_SECRET_KEY=<Secret Access Key z tokenu R2>

# --- Silnik TTS ---
ENGINE_MODE=auto          # auto | voxcpm2 | piper | demo  (piper = prawdziwa mowa na CPU, bez GPU)
WITH_VOXCPM=false         # true = obraz z biblioteką voxcpm (wymaga GPU)

# Silnik na zewnętrznym GPU (puste = kontener tts-engine z tego pliku compose)
ENGINE_URL=
ENGINE_API_KEY=

# --- Logowanie przez Google (opcjonalne) ---
GOOGLE_CLIENT_ID=

# --- Płatności Stripe (opcjonalne) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_YEARLY=

# --- Konta ---
# Generowanie dopiero po potwierdzeniu adresu e-mail (wymaga działającego SMTP)
REQUIRE_EMAIL_VERIFICATION=true
# Nocne sprzątanie historii i osieroconych plików audio (cron Springa)
CLEANUP_CRON=0 30 3 * * *

# --- E-mail SMTP (reset hasła, potwierdzenie adresu) ---
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=Narrivy <no-reply@example.com>

# --- Tylko lokalne testy ---
SEED_DEMO_DATA=false
DEMO_PLAN_SWITCH=false
