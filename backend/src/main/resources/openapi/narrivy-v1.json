  "webhooks": {
    "jobFinished": {
      "post": {
        "summary": "Zakończenie zadania",
        "description": "Wysyłany na `callback_url` po zakończeniu zadania (`job.succeeded` lub `job.failed`). Nagłówek `Narrivy-Signature: t=<unix>,v1=<hex>` zawiera HMAC-SHA256 z tekstu `t + \".\" + body` podpisany sekretem webhooków (Ustawienia → API). Odpowiedz kodem 2xx; w przeciwnym razie ponowimy wysyłkę po 10 s, 1 min, 5 min i 30 min.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookEvent"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Odebrano."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "`Authorization: Bearer nrv_live_…`"
      },
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "schemas": {
      "SpeechRequest": {
        "type": "object",
        "required": [
          "text",
          "voice_id"
        ],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "description": "Tekst do przeczytania. Znaczniki pauz: `[pauza 1s]`, `[pauza 500ms]`."
          },
          "voice_id": {
            "type": "string",
            "description": "Identyfikator z `GET /v1/voices`."
          },
          "language": {
            "type": "string",
            "description": "Kod języka (np. `pl`, `en`, `de`); domyślnie pierwszy język głosu. 30 języków."
          },
          "format": {
            "type": "string",
            "enum": [
              "mp3",
              "wav"
            ],
            "default": "mp3"
          },
          "style": {
            "type": "string",
            "maxLength": 300,
            "description": "Opis sposobu mówienia, np. „spokojna narracja, wyraźna dykcja”."
          },
          "emotion": {
            "type": "string",
            "maxLength": 60,
            "examples": [
              "Neutral",
              "Happy",
              "Whisper",
              "Calm",
              "Sad",
              "Excited",
              "Serious",
              "Menacing"
            ]
          },
          "speed": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 2.0,
            "default": 1.0
          },
          "expressiveness": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
