{
  "openapi": "3.1.0",
  "info": {
    "title": "Narrivy API",
    "version": "1.0.0",
    "description": "Zamiana tekstu na mowę (TTS) z głosami Narrivy. Uwierzytelnianie kluczem API utworzonym w Ustawieniach → API. Dostęp w planach Pro i Business. Znaki zużyte przez API liczą się do miesięcznego limitu planu i dokupionych pakietów.\n\nKlucz API przechowuj wyłącznie po stronie serwera — nie umieszczaj go w kodzie przeglądarki ani aplikacji mobilnej."
  },
  "servers": [
    {
      "url": "/",
      "description": "Ten serwer"
    }
  ],
  "security": [
    {
      "bearer": []
    },
    {
      "apiKey": []
    }
  ],
  "tags": [
    {
      "name": "Synteza mowy"
    },
    {
      "name": "Zadania"
    },
    {
      "name": "Głosy"
    },
    {
      "name": "Konto"
    }
  ],
  "paths": {
    "/v1/text-to-speech": {
      "post": {
        "tags": [
          "Synteza mowy"
        ],
        "operationId": "textToSpeech",
        "summary": "Synteza mowy (synchronicznie)",
        "description": "Zwraca plik audio. Do 5 000 znaków; dłuższe teksty wysyłaj jako zadanie (`POST /v1/text-to-speech/jobs`). Plik zawiera w metadanych oznaczenie treści wygenerowanej przez AI.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SpeechRequest"
              },
              "example": {
                "text": "Dzień dobry! Tak brzmi Narrivy.",
                "voice_id": "voice_warm_velvet",
                "language": "pl",
                "format": "mp3",
                "emotion": "Happy"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Nagranie.",
            "headers": {
              "X-RateLimit-Limit": {
                "schema": {
                  "type": "integer"
                },
                "description": "Limit żądań na minutę w Twoim planie."
              },
              "X-RateLimit-Remaining": {
                "schema": {
                  "type": "integer"
                },
                "description": "Pozostałe żądania w bieżącej minucie."
              },
              "X-RateLimit-Reset": {
                "schema": {
                  "type": "integer"
                },
                "description": "Sekundy do odnowienia limitu."
              },
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                },
                "description": "Identyfikator żądania (podaj go, kontaktując się z pomocą)."
              },
              "X-Characters": {
                "schema": {
                  "type": "integer"
                },
                "description": "Naliczone znaki."
              },
              "X-Duration-Ms": {
                "schema": {
                  "type": "integer"
                },
                "description": "Długość nagrania w ms."
              },
              "X-Engine-Mode": {
                "schema": {
                  "type": "string"
                },
                "description": "Silnik, który wygenerował nagranie (`voxcpm2`, `piper`, `demo`)."
              }
            },
            "content": {
              "audio/mpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "audio/wav": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Niepoprawne dane (`invalid_request`, `invalid_json`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Brak lub nieprawidłowy klucz API (`missing_api_key`, `invalid_api_key`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Plan bez dostępu do API (`plan_required`) lub niepotwierdzony e-mail (`email_not_verified`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Limit żądań na minutę (`rate_limit_exceeded`) lub równoległych syntez (`concurrency_limit_exceeded`). Sprawdź nagłówek `Retry-After`.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Po ilu sekundach ponowić."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "402": {
            "description": "Wyczerpany limit znaków planu i pakietów (`quota_exceeded`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Nieznany głos (`voice_not_found`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Tekst za długi dla wywołania synchronicznego (`text_too_long`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Silnik zajęty (`engine_busy`, ponów po `Retry-After`) lub niedostępny (`engine_unavailable`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/text-to-speech/jobs": {
      "post": {
        "tags": [
          "Zadania"
        ],
        "operationId": "createTextToSpeechJob",
        "summary": "Utwórz zadanie syntezy (w tle)",
        "description": "Dla długich tekstów — do limitu znaków w projekcie z Twojego planu (Pro: 100 000, Business: 500 000). Wynik jest dostępny przez 7 dni. Podaj `callback_url`, aby otrzymać webhook po zakończeniu. Nagłówek `Idempotency-Key` chroni przed podwójnym utworzeniem zadania przy ponowieniu żądania.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 255
            },
            "description": "Unikalny klucz operacji (np. UUID). Ponowne żądanie z tym samym kluczem zwraca istniejące zadanie."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SpeechRequest"
              },
              "example": {
                "text": "Rozdział pierwszy. …",
                "voice_id": "voice_warm_narrator",
                "format": "mp3",
                "callback_url": "https://example.com/narrivy/webhook"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Zadanie przyjęte.",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              },
              "X-RateLimit-Limit": {
                "schema": {
                  "type": "integer"
                },
                "description": "Limit żądań na minutę w Twoim planie."
              },
              "X-RateLimit-Remaining": {
                "schema": {
                  "type": "integer"
                },
                "description": "Pozostałe żądania w bieżącej minucie."
              },
              "X-RateLimit-Reset": {
                "schema": {
                  "type": "integer"
                },
                "description": "Sekundy do odnowienia limitu."
              },
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                },
                "description": "Identyfikator żądania (podaj go, kontaktując się z pomocą)."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "400": {
            "description": "Niepoprawne dane.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Brak lub nieprawidłowy klucz API (`missing_api_key`, `invalid_api_key`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Plan bez dostępu do API (`plan_required`) lub niepotwierdzony e-mail (`email_not_verified`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Limit żądań na minutę (`rate_limit_exceeded`) lub równoległych syntez (`concurrency_limit_exceeded`). Sprawdź nagłówek `Retry-After`.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Po ilu sekundach ponowić."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Nieznany głos (`voice_not_found`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Tekst przekracza limit planu (`text_too_long`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
